<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<title>Ubuntu Patch Compliance Report</title>

<style>

body {
    font-family: Arial, Helvetica, sans-serif;
    margin: 20px;
    background-color: #f5f5f5;
}

h1 {
    color: #2c3e50;
}

.server {
    background: white;
    padding: 15px;
    margin-bottom: 25px;
    border-radius: 5px;
    box-shadow: 0 1px 5px rgba(0,0,0,0.2);
}

table {
    border-collapse: collapse;
    width: 100%;
    margin-top: 10px;
}

th {
    background-color: #4472C4;
    color: white;
    padding: 8px;
    border: 1px solid #ddd;
}

td {
    border: 1px solid #ddd;
    padding: 8px;
}

pre {
    background: #f8f8f8;
    border: 1px solid #ddd;
    padding: 10px;
}

.package-table {
    display: block;
    max-height: 400px;
    overflow-y: auto;
}

</style>

</head>

<body>

<h1>Ubuntu Patch Compliance Report</h1>

<p>
Generated On:
<strong>{{ lookup('pipe', 'date') }}</strong>
</p>

{% for host in ansible_play_hosts %}

<div class="server">

<h2>{{ hostvars[host].hostname_out.stdout }}</h2>

<table>
<tr>
    <th>Hostname</th>
    <td>{{ hostvars[host].hostname_out.stdout }}</td>
</tr>

<tr>
    <th>OS Version</th>
    <td>{{ hostvars[host].os_info.stdout }}</td>
</tr>

<tr>
    <th>Kernel Version</th>
    <td>{{ hostvars[host].kernel_info.stdout }}</td>
</tr>

<tr>
    <th>Total Installed Packages</th>
    <td>{{ hostvars[host].pkg_count.stdout }}</td>
</tr>
</table>

<h3>Last Dist Upgrade Information</h3>

<pre>{{ hostvars[host].patch_info.stdout | default('No dist-upgrade history found') }}</pre>

<h3>Installed Packages</h3>

<div class="package-table">

<table>

<tr>
    <th>Package Name</th>
    <th>Version</th>
</tr>

{% for pkg in hostvars[host].pkg_list.stdout_lines %}
{% set p = pkg.split('|') %}

<tr>
    <td>{{ p[0] }}</td>
    <td>{{ p[1] }}</td>
</tr>

{% endfor %}

</table>

</div>

</div>

{% endfor %}

</body>
</html>
